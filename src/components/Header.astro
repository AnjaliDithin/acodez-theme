<script is:inline>
  function initHeader() {
    console.log("✅ Header script running");

    /* ================= STICKY HEADER ================= */
    const header = document.querySelector(".header_sticky");
    if (!header) {
      console.warn("❌ .header_sticky not found");
      return;
    }

    let lastScroll = 0;

    window.addEventListener("scroll", () => {
      const scrollPos = window.pageYOffset;
      const headerHeight = header.offsetHeight;

      if (scrollPos <= 0) {
        header.style.top = "0px";
        header.classList.remove("scrolled");
      } else if (scrollPos > lastScroll) {
        header.style.top = `-${headerHeight}px`;
      } else {
        header.style.top = "0px";
        header.classList.add("scrolled");
      }

      lastScroll = scrollPos;
    });

    /* ================= MEGAMENU TRIGGER ================= */
    const openMenuBtn = document.querySelector(".open-menu");
    const closeMenuBtn = document.getElementById("closeMegamenu");
    const megamenuOverlay = document.getElementById("megamenuOverlay");

    if (openMenuBtn && megamenuOverlay && closeMenuBtn) {
      openMenuBtn.addEventListener("click", () => {
        megamenuOverlay.classList.add("active");
        document.body.classList.add("no-scroll");
        document.documentElement.classList.add("no-scroll");
      });

      closeMenuBtn.addEventListener("click", () => {
        megamenuOverlay.classList.remove("active");
        document.body.classList.remove("no-scroll");
        document.documentElement.classList.remove("no-scroll");
      });

      // Close on escape
      document.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          megamenuOverlay.classList.contains("active")
        ) {
          megamenuOverlay.classList.remove("active");
          document.body.classList.remove("no-scroll");
          document.documentElement.classList.remove("no-scroll");
        }
      });
    }
  }

  /* ✅ Run on first load */
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeader);
  } else {
    initHeader();
  }

  /* ✅ Run on Astro navigation */
  document.addEventListener("astro:page-load", initHeader);
</script>
<script is:inline>
  (() => {
    "use strict";

    /* ================= HEADER ================= */
    function initHeader() {
      const header = document.querySelector(".header_sticky");
      if (!header) return;

      let lastScroll = 0;

      window.addEventListener("scroll", () => {
        const scrollPos = window.pageYOffset;
        const headerHeight = header.offsetHeight;

        if (scrollPos <= 0) {
          header.style.top = "0px";
          header.classList.remove("scrolled");
        } else if (scrollPos > lastScroll) {
          header.style.top = `-${headerHeight}px`;
        } else {
          header.style.top = "0px";
          header.classList.add("scrolled");
        }

        lastScroll = scrollPos;
      });

      const openMenuBtn = document.querySelector(".open-menu");
      const closeMenuBtn = document.getElementById("closeMegamenu");
      const megamenuOverlay = document.getElementById("megamenuOverlay");

      if (!openMenuBtn || !closeMenuBtn || !megamenuOverlay) return;

      openMenuBtn.onclick = () => {
        megamenuOverlay.classList.add("active");
        document.body.classList.add("no-scroll");
        document.documentElement.classList.add("no-scroll");
      };

      closeMenuBtn.onclick = () => {
        megamenuOverlay.classList.remove("active");
        document.body.classList.remove("no-scroll");
        document.documentElement.classList.remove("no-scroll");
      };

      document.addEventListener("keydown", e => {
        if (e.key === "Escape" && megamenuOverlay.classList.contains("active")) {
          megamenuOverlay.classList.remove("active");
          document.body.classList.remove("no-scroll");
          document.documentElement.classList.remove("no-scroll");
        }
      });
    }

    /* ================= MEGAMENU SERVICES ================= */
    function initMegamenuServices() {
      const megamenu = document.getElementById("megamenuOverlay");
      const tabs = document.querySelectorAll(".megamenu-tabs li");
      const submenus = document.querySelectorAll(".menu-grid .submenu");
      const menuGrid = document.querySelector(".menu-grid");

      if (!megamenu || !tabs.length || !menuGrid) return;

      const isMobile = () => window.innerWidth < 991;

      const getSubmenu = key =>
        Array.from(submenus).find(sm => sm.dataset.menu === key);

      function activateItem(item) {
        const target = getSubmenu(item.dataset.menu);

        tabs.forEach(t => t.classList.remove("active"));
        submenus.forEach(sm => sm.classList.remove("active"));

        item.classList.add("active");

        if (!target) return;

        target.classList.add("active");

        if (isMobile()) {
          item.appendChild(target);
        } else if (target.parentElement !== menuGrid) {
          menuGrid.appendChild(target);
        }
      }

      function restoreDesktop() {
        submenus.forEach(sm => {
          if (sm.parentElement !== menuGrid) {
            menuGrid.appendChild(sm);
          }
        });
      }

      function setFirstActive() {
        if (!isMobile()) activateItem(tabs[0]);
      }

      tabs.forEach(tab => {
        tab.addEventListener("mouseenter", () => {
          if (!isMobile()) activateItem(tab);
        });

        tab.addEventListener("click", () => {
          if (!isMobile()) return;

          if (tab.classList.contains("active")) {
            tab.classList.remove("active");
            const sm = getSubmenu(tab.dataset.menu);
            if (sm) sm.classList.remove("active");
          } else {
            activateItem(tab);
          }
        });
      });

      window.addEventListener("resize", () => {
        if (!isMobile()) {
          restoreDesktop();
          if (!document.querySelector(".megamenu-tabs li.active")) {
            setFirstActive();
          }
        } else {
          const active = document.querySelector(".megamenu-tabs li.active");
          if (active) activateItem(active);
        }
      });

      const observer = new MutationObserver(() => {
        if (megamenu.classList.contains("active") && !isMobile()) {
          setFirstActive();
        }
      });

      observer.observe(megamenu, { attributes: true });

      setFirstActive();
    }

    /* ================= ASTRO SAFE INIT ================= */
    function run() {
      initHeader();
      initMegamenuServices();
    }

    document.addEventListener("DOMContentLoaded", run);
    document.addEventListener("astro:page-load", run);
  })();
</script>

